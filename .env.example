# Copy this file to .env (project root or core/) and replace the dummy values.

# Django
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
# Host names only, without ports
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS: the frontend origin allowed to call the API (e.g. a local React/Vite app)
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Email notifications via Resend (optional).
# Leave RESEND_API_KEY empty to skip sending emails; submissions are still scored and saved.
RESEND_API_KEY=
OWNER_EMAIL=user@example.com
FROM_EMAIL=Jane Doe <noreply@example.org>

# Spam classifier
SPAM_THRESHOLD=0.70
MODEL_PATH=models/spam_classifier_v1.joblib
